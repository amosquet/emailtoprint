# IMAP Configuration
IMAP_HOST=imap.example.com
IMAP_USERNAME=your_email@example.com
IMAP_PASSWORD=your_password

# Sentry Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here

# Uptime Kuma Push / Heartbeat Monitoring (Optional)
# Paste your Uptime Kuma Push URL here (e.g., https://uptime.example.com/api/push/key?status=up&msg=OK&ping=)
UPTIME_KUMA_PUSH_URL=
HEARTBEAT_INTERVAL=60

# Print Configuration
# Maximum number of pages to print per attachment
PAGE_LIMIT=5

# Specify the target printer name. Leave blank to use the system default printer.
PRINTER_NAME=
